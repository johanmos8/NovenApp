<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules, for API < 31 (devices that don't read
   data_extraction_rules.xml - this app's minSdk is 28, so this file still matters for
   real users). Mirrors data_extraction_rules.xml: back up progress and notification
   preferences, never the debug forced-date override. See the P3-3 finding in
   specs/code-audit-v3. debug_settings.xml is left out simply by not being included:
   an <exclude> for a path outside every <include> is rejected by lint (FullBackupContent,
   fatal in release builds).
-->
<full-backup-content>
    <include domain="file" path="datastore/devotional_progress.preferences_pb"/>
    <include domain="file" path="datastore/devotional_notifications.preferences_pb"/>
</full-backup-content>
